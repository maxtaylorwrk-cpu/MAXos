# Max OS runtime variables
# NEVER put real secret values in this file.

# Supabase-provided server environment
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Single-owner V1 gate
# Despite the legacy name, APP_PASSPHRASE is now used as the one owner key.
APP_PASSPHRASE=

# AI provider
GROQ_API_KEY=

# Backup tooling (local owner use only)
# Example: postgres://user:password@host:5432/postgres
BACKUP_DB_URL=
# Default local output directory (override as needed)
BACKUP_DIR=$HOME/maxos-backups
# Optional non-interactive GPG passphrase. Prefer secure prompting/password-manager workflows;
# never commit a value and unset it after use.
BACKUP_ENCRYPTION_PASSPHRASE=

# SESSION_SECRET was retired from V1 on 2026-07-28.
